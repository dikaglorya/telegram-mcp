# Telegram MTProto application credentials — from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: phone number in international format (+15551234567).
# If set, login only ever asks for the code — the agent won't prompt for a number.
# TELEGRAM_PHONE=+15551234567

# --- Access policy (optional) ---
# Full access is the default. Leave these empty to allow every chat the account
# can reach. To restrict, set ALLOW_ALL to false and list chats by @username,
# numeric id, or exact title (comma separated).
TELEGRAM_ALLOW_ALL_CHATS=true
# TELEGRAM_ALLOWED_CHATS=@somechat,123456789

# --- Storage ---
# Session file (0600), media downloads, exports, state, audit log.
# TELEGRAM_STATE_DIR=~/.telegram-mcp
# TELEGRAM_SESSION_PATH=~/.telegram-mcp/session.txt
# TELEGRAM_MEDIA_DIR=~/.telegram-mcp/media
# TELEGRAM_EXPORT_DIR=~/.telegram-mcp/exports
# TELEGRAM_AUDIT_LOG=~/.telegram-mcp/audit.log

# --- Media ---
# 0 or unset = unlimited; otherwise a byte cap for downloads.
# TELEGRAM_MAX_DOWNLOAD_BYTES=52428800

# --- Launcher ---
# Override the Node.js binary the `telegram-mcp` command spawns.
# Usually unnecessary — it defaults to the Node running the launcher.
# TELEGRAM_MCP_NODE=/path/to/node
